#!/bin/bash

echo "============================================="
echo "🚀 커밋 전 검사 시작 (Ruff 린트 & Pytest 검증)"
echo "============================================="

# 1. backend 폴더로 이동
cd backend || { echo "❌ backend 폴더를 찾을 수 없습니다."; exit 1; }

# 2. Ruff로 코드 먼저 자동 수정 (--fix)
echo "🧹 [1/2] Ruff로 코드를 자동으로 수정하는 중..."
uv run ruff check --fix .
RUFF_EXIT=$?

# Ruff 검사 자체에서 문법 오류 등으로 완전히 깨진 경우 체크
if [ $RUFF_EXIT -ne 0 ]; then
    echo "❌ Ruff 린트 과정에서 치명적인 오류가 발생했습니다."
    exit 1
fi

# 3. Pytest로 테스트 코드 검증
echo "🧪 [2/2] Pytest 테스트 실행 중..."
uv run python -m pytest
PYTEST_EXIT=$?

# 테스트가 하나라도 실패하면 커밋 중단
if [ $PYTEST_EXIT -ne 0 ]; then
    echo "============================================="
    echo "❌ 테스트가 실패했습니다! 코드를 확인하고 다시 커밋하세요."
    echo "============================================="
    exit 1  # 0이 아닌 값을 반환하여 Git 커밋을 강제로 중단시킴
fi

echo "============================================="
echo "✅ 모든 검사 통과! 커밋을 진행합니다."
echo "============================================="
exit 0
